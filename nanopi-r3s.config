# 注意：以下为旧 armvirt 通用 ARM64 目标，不是 Rockchip NanoPi R3S 专用配置。
# Target Config
CONFIG_TARGET_armvirt=y
CONFIG_TARGET_armvirt_64=y
CONFIG_TARGET_armvirt_64_DEVICE_generic=y

# Root filesystem images
CONFIG_TARGET_ROOTFS_EXT4FS=n
CONFIG_TARGET_ROOTFS_SQUASHFS=y


# Applications
CONFIG_PACKAGE_luci-app-accesscontrol=n
CONFIG_PACKAGE_luci-app-adbyby-plus=n
CONFIG_PACKAGE_luci-app-adguardhome=n
CONFIG_PACKAGE_luci-app-airplay2=n
CONFIG_PACKAGE_luci-app-alist=n
# CONFIG_PACKAGE_luci-app-aliyundrive-fuse is not set
# CONFIG_PACKAGE_luci-app-aliyundrive-webdav is not set
# CONFIG_PACKAGE_luci-app-amule is not set
CONFIG_PACKAGE_luci-app-argon-config=n
CONFIG_PACKAGE_luci-app-aria2=n
CONFIG_PACKAGE_luci-app-cifs-mount=n
CONFIG_PACKAGE_luci-app-commands=n
CONFIG_PACKAGE_luci-app-ddns=n
# CONFIG_PACKAGE_luci-app-ddnsto is not set

CONFIG_PACKAGE_luci-app-dockerman=n
CONFIG_PACKAGE_luci-app-eqos=n
CONFIG_PACKAGE_luci-app-filebrowser=n
CONFIG_PACKAGE_luci-app-frpc=n
CONFIG_PACKAGE_luci-app-frps=n
# CONFIG_PACKAGE_luci-app-guest-wifi is not set
CONFIG_PACKAGE_luci-app-hd-idle=n
CONFIG_PACKAGE_luci-app-ikoolproxy=n
CONFIG_PACKAGE_luci-app-ipsec-vpnd=n
CONFIG_PACKAGE_luci-app-kodexplorer=n
CONFIG_PACKAGE_luci-app-minidlna=n
# CONFIG_PACKAGE_luci-app-mjpg-streamer is not set
CONFIG_PACKAGE_luci-app-msd_lite=n
# CONFIG_PACKAGE_luci-app-music-remote-center is not set
CONFIG_PACKAGE_luci-app-mwan3=n
CONFIG_PACKAGE_luci-app-mwan3helper=n
CONFIG_PACKAGE_luci-app-n2n=n
CONFIG_PACKAGE_luci-app-netdata=n
CONFIG_PACKAGE_luci-app-nfs=n
CONFIG_PACKAGE_luci-app-nlbwmon=n
CONFIG_PACKAGE_luci-app-nps=n
CONFIG_PACKAGE_luci-app-oaf=n
CONFIG_PACKAGE_luci-app-onliner=n
CONFIG_PACKAGE_luci-app-openclash=n
CONFIG_PACKAGE_luci-app-openvpn-server=n
CONFIG_PACKAGE_luci-app-poweroff=n
CONFIG_PACKAGE_luci-app-pptp-server=n
CONFIG_PACKAGE_luci-app-pushbot=n
CONFIG_PACKAGE_luci-app-qbittorrent=n
# CONFIG_PACKAGE_luci-app-qbittorrent_static is not set
CONFIG_PACKAGE_luci-app-qbittorrent_dynamic=n
CONFIG_PACKAGE_luci-app-ramfree=n
CONFIG_PACKAGE_luci-app-rclone=n
# CONFIG_PACKAGE_luci-app-samba is not set
CONFIG_PACKAGE_luci-app-samba4=n
CONFIG_PACKAGE_luci-app-serverchan=n
CONFIG_PACKAGE_luci-app-smartdns=n
CONFIG_PACKAGE_luci-app-socat=n
CONFIG_PACKAGE_luci-app-softethervpn=n
CONFIG_PACKAGE_luci-app-sqm=n
CONFIG_PACKAGE_luci-app-ssr-plus=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Hysteria=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan=n
CONFIG_PACKAGE_luci-app-store=n
CONFIG_PACKAGE_luci-app-syncdial=n
CONFIG_PACKAGE_luci-app-transmission=n
CONFIG_PACKAGE_luci-app-udpxy=n
CONFIG_PACKAGE_luci-app-uhttpd=n
CONFIG_PACKAGE_luci-app-unblockmusic=n
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-app-usb-printer=n
CONFIG_PACKAGE_luci-app-uugamebooster=n
CONFIG_PACKAGE_luci-app-v2ray-server=n
CONFIG_PACKAGE_luci-app-verysync=n
CONFIG_PACKAGE_luci-app-vlmcsd=n
CONFIG_PACKAGE_luci-app-vsftpd=n
CONFIG_PACKAGE_luci-app-vssr=n
CONFIG_PACKAGE_luci-app-vssr_INCLUDE_Kcptun=n
# CONFIG_PACKAGE_luci-app-watchcat is not set
# CONFIG_PACKAGE_luci-app-webadmin is not set
# CONFIG_PACKAGE_luci-app-wifischedule is not set
CONFIG_PACKAGE_luci-app-wireguard=n
CONFIG_PACKAGE_luci-app-wol=n
CONFIG_PACKAGE_luci-app-wrtbwmon=n
CONFIG_PACKAGE_luci-app-xlnetacc=n
CONFIG_PACKAGE_luci-app-zerotier=n
CONFIG_PACKAGE_luci-app-homeproxy=n

# The required plugins
# 网络加速设置；实际加速引擎与 BBR 由当前 feed 的配置决定
CONFIG_PACKAGE_luci-app-turboacc=y
# 旧版 PDNSD 开关；当前 turboacc 已无此字段，不能据此确认会编译 PDNSD
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_PDNSD=y
# LuCI 网页文件上传/下载
CONFIG_PACKAGE_luci-app-filetransfer=y
# 定时重启
CONFIG_PACKAGE_luci-app-autoreboot=y
# IP 与 MAC 地址绑定
CONFIG_PACKAGE_luci-app-arpbind=y
# 网页终端；会带入 ttyd
CONFIG_PACKAGE_luci-app-ttyd=y
# PassWall 25.11.15-1；由 feeds 的 commit 与版本检查脚本锁定
CONFIG_PACKAGE_luci-app-passwall=y
# PassWall2 25.11.18-1；由 feeds 的 commit 与版本检查脚本锁定
CONFIG_PACKAGE_luci-app-passwall2=y
# 磁盘/分区管理；会带入 parted、SMART 和文件系统工具等
CONFIG_PACKAGE_luci-app-diskman=y
# LuCI 防火墙管理页面
CONFIG_PACKAGE_luci-app-firewall=y
# Design 主题设置（X86 未启用，ARM 配置启用）
CONFIG_PACKAGE_luci-app-design-config=y

# theme
# Argon 主题（X86 未启用，ARM 配置启用）
CONFIG_PACKAGE_luci-theme-argon=y
# Design 主题（X86 未启用，ARM 配置启用）
CONFIG_PACKAGE_luci-theme-design=y

# NO Software
CONFIG_PACKAGE_cpufreq=n
CONFIG_PACKAGE_autosamba=n
CONFIG_PACKAGE_coremark=n
CONFIG_PACKAGE_ddns-scripts=n
CONFIG_PACKAGE_ddns-scripts-services=n
CONFIG_PACKAGE_ddns-scripts_aliyun=n
CONFIG_PACKAGE_ddns-scripts_dnspod=n
